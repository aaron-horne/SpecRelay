NODE_ENV=development
# Explicit rollout gate for OWNER-initiated Jev connection tests and readiness.
# Leave unset/false until Phase 1B security and schema gates pass.
SEMANTIC_PROVIDERS_ENABLED=false
# Comma-separated workspace UUIDs eligible for explicit OWNER tests and Ready.
# Empty or malformed lists deny every workspace. Never use a wildcard.
SEMANTIC_PROVIDER_TEST_WORKSPACE_IDS=
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specrelay
LOG_LEVEL=info

# Clerk credentials. Replit-managed Clerk provides test keys in development and
# live keys in production. The server and browser publishable-key names are
# separate because Vite exposes only the VITE_ variable to browser code.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Production: exactly 32 random bytes, base64 encoded. Never log or commit.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_ID=credential-key-current
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Rotation only: keep the prior key until old ciphertext has been re-encrypted.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS_ID=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS_VERSION=

# SESSION_SECRET fallback is development/test compatibility only; forbidden in production.
SESSION_SECRET=
